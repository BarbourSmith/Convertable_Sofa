                },
                {
                  "atomType": "Code",
                  "x": 0.2,
                  "y": 0.5,
                  "uniqueID": "id-1125750",
                  "ioValues": [
                    {
                      "name": "depth",
                      "ioValue": 800
                    },
                    {
                      "name": "deckZ",
                      "ioValue": 290
                    },
                    {
                      "name": "frontBottomY",
                      "ioValue": 82
                    },
                    {
                      "name": "frontBottomZ",
                      "ioValue": 167
                    },
                    {
                      "name": "apexY",
                      "ioValue": 287
                    },
                    {
                      "name": "apexZ",
                      "ioValue": 93
                    },
                    {
                      "name": "apexRadius",
                      "ioValue": 45
                    },
                    {
                      "name": "backBottomY",
                      "ioValue": 778
                    },
                    {
                      "name": "backBottomZ",
                      "ioValue": 202
                    },
                    {
                      "name": "pivotY",
                      "ioValue": 362.4
                    },
                    {
                      "name": "pivotZ",
                      "ioValue": 247.5
                    },
                    {
                      "name": "strutAngle",
                      "ioValue": 55.5
                    },
                    {
                      "name": "lockPinOffset",
                      "ioValue": 110
                    },
                    {
                      "name": "holeDiameter",
                      "ioValue": 12
                    }
                  ],
                  "interpreterVersion": 1,
                  "code": "/**\n * Side profile of one layer of the triangular base (traced from the side photo),\n * in sofa coordinates: x = depth from the front, y = height above the floor, mm.\n * The top edge is the seat deck surface. The bottom forms a shallow V whose\n * rounded low point sits under the back/arm pivot.\n * Holes: pivot (the back/arm bracket rotates here), sofa lock pin (bracket's lower\n * end pinned here when upright) and bed lock pin (same bracket hole after flipping\n * the back forward flat).\n */\nfunction run(\n  depth: number = 800,\n  deckZ: number = 290,\n  frontBottomY: number = 82,\n  frontBottomZ: number = 167,\n  apexY: number = 287,\n  apexZ: number = 93,\n  apexRadius: number = 45,\n  backBottomY: number = 778,\n  backBottomZ: number = 202,\n  pivotY: number = 362.4,\n  pivotZ: number = 247.5,\n  strutAngle: number = 55.5,\n  lockPinOffset: number = 110,\n  holeDiameter: number = 12,\n): Assembly {\n  // Points on the two bottom edges, apexRadius away from the apex, joined by an arc\n  const toward = (p: number[], q: number[], dist: number) => {\n    const dx = q[0] - p[0];\n    const dy = q[1] - p[1];\n    const len = Math.hypot(dx, dy);\n    return [p[0] + (dx / len) * dist, p[1] + (dy / len) * dist];\n  };\n  const apex = [apexY, apexZ];\n  const a1 = toward(apex, [frontBottomY, frontBottomZ], apexRadius);\n  const a2 = toward(apex, [backBottomY, backBottomZ], apexRadius);\n  const aMid = toward(apex, [(a1[0] + a2[0]) / 2, (a1[1] + a2[1]) / 2], apexRadius * 0.35);\n\n  const outline = replicad\n    .draw([0, deckZ])\n    .lineTo([frontBottomY, frontBottomZ])\n    .lineTo(a1)\n    .threePointsArcTo(a2, aMid)\n    .lineTo([backBottomY, backBottomZ])\n    .lineTo([depth, deckZ])\n    .close();\n\n  const a = (strutAngle * Math.PI) / 180;\n  const holes = [\n    [pivotY, pivotZ],\n    [pivotY - lockPinOffset * Math.cos(a), pivotZ - lockPinOffset * Math.sin(a)],\n    [pivotY + lockPinOffset, pivotZ],\n  ];\n  let shape = outline;\n  for (const h of holes) {\n    shape = shape.cut(replicad.drawCircle(holeDiameter / 2).translate(h[0], h[1]));\n  }\n  return new Assembly({ geometry: shape });\n}\n",
                  "compiledCode": "\"use strict\";\n/**\n * Side profile of one layer of the triangular base (traced from the side photo),\n * in sofa coordinates: x = depth from the front, y = height above the floor, mm.\n * The top edge is the seat deck surface. The bottom forms a shallow V whose\n * rounded low point sits under the back/arm pivot.\n * Holes: pivot (the back/arm bracket rotates here), sofa lock pin (bracket's lower\n * end pinned here when upright) and bed lock pin (same bracket hole after flipping\n * the back forward flat).\n */\nfunction run(depth = 800, deckZ = 290, frontBottomY = 82, frontBottomZ = 167, apexY = 287, apexZ = 93, apexRadius = 45, backBottomY = 778, backBottomZ = 202, pivotY = 362.4, pivotZ = 247.5, strutAngle = 55.5, lockPinOffset = 110, holeDiameter = 12) {\n    // Points on the two bottom edges, apexRadius away from the apex, joined by an arc\n    const toward = (p, q, dist) => {\n        const dx = q[0] - p[0];\n        const dy = q[1] - p[1];\n        const len = Math.hypot(dx, dy);\n        return [p[0] + (dx / len) * dist, p[1] + (dy / len) * dist];\n    };\n    const apex = [apexY, apexZ];\n    const a1 = toward(apex, [frontBottomY, frontBottomZ], apexRadius);\n    const a2 = toward(apex, [backBottomY, backBottomZ], apexRadius);\n    const aMid = toward(apex, [(a1[0] + a2[0]) / 2, (a1[1] + a2[1]) / 2], apexRadius * 0.35);\n    const outline = replicad\n        .draw([0, deckZ])\n        .lineTo([frontBottomY, frontBottomZ])\n        .lineTo(a1)\n        .threePointsArcTo(a2, aMid)\n        .lineTo([backBottomY, backBottomZ])\n        .lineTo([depth, deckZ])\n        .close();\n    const a = (strutAngle * Math.PI) / 180;\n    const holes = [\n        [pivotY, pivotZ],\n        [pivotY - lockPinOffset * Math.cos(a), pivotZ - lockPinOffset * Math.sin(a)],\n        [pivotY + lockPinOffset, pivotZ],\n    ];\n    let shape = outline;\n    for (const h of holes) {\n        shape = shape.cut(replicad.drawCircle(holeDiameter / 2).translate(h[0], h[1]));\n    }\n    return new Assembly({ geometry: shape });\n}\n"
                },
