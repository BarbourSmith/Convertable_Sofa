                  "type": "number",
                  "options": []
                },
                {
                  "atomType": "Code",
                  "x": 0.2,
                  "y": 0.5,
                  "uniqueID": "id-1125750",
                  "ioValues": [
                    {
                      "name": "depth",
                      "ioValue": 800
                    },
                    {
                      "name": "deckZ",
                      "ioValue": 209.55,
                      "currentEquation": "152.4 + 3*thickness"
                    },
                    {
                      "name": "frontEndHeight",
                      "ioValue": 57.150000000000006,
                      "currentEquation": "3*thickness"
                    },
                    {
                      "name": "frontEndSlant",
                      "ioValue": 7.5
                    },
                    {
                      "name": "backEndHeight",
                      "ioValue": 68.15,
                      "currentEquation": "3*thickness + 11"
                    },
                    {
                      "name": "backEndSlant",
                      "ioValue": 5
                    },
                    {
                      "name": "apexY",
                      "ioValue": 305
                    },
                    {
                      "name": "apexZ",
                      "ioValue": 30
                    },
                    {
                      "name": "apexRadius",
                      "ioValue": 45
                    },
                    {
                      "name": "pivotY",
                      "ioValue": 292
                    },
                    {
                      "name": "pivotZ",
                      "ioValue": 81
                    },
                    {
                      "name": "knobY",
                      "ioValue": 460
                    },
                    {
                      "name": "knobZ",
                      "ioValue": 171
                    },
                    {
                      "name": "holeDiameter",
                      "ioValue": 12
                    }
                  ],
                  "interpreterVersion": 1,
                  "code": "/**\n * Side profile of one layer of the base, traced from the close-up side photo,\n * in sofa coordinates: x = depth from the front, y = height above the floor, mm.\n * An inverted triangle: the top edge is the seat deck surface, the short ends cover\n * the rails, and the bottom edges meet in a point just above the floor, under the\n * back/arm bracket's pivot.\n * Holes: the pivot the back/arm bracket rotates on, and the knob.\n */\nfunction run(\n  depth: number = 800,\n  deckZ: number = 209.6,\n  frontEndHeight: number = 57,\n  frontEndSlant: number = 7.5,\n  backEndHeight: number = 68,\n  backEndSlant: number = 5,\n  apexY: number = 305,\n  apexZ: number = 30,\n  apexRadius: number = 12,\n  pivotY: number = 292,\n  pivotZ: number = 81,\n  knobY: number = 460,\n  knobZ: number = 171,\n  holeDiameter: number = 12,\n): Assembly {\n  const toward = (p: number[], q: number[], dist: number) => {\n    const dx = q[0] - p[0];\n    const dy = q[1] - p[1];\n    const len = Math.hypot(dx, dy);\n    return [p[0] + (dx / len) * dist, p[1] + (dy / len) * dist];\n  };\n  const frontBottom = [frontEndSlant, deckZ - frontEndHeight];\n  const backBottom = [depth - backEndSlant, deckZ - backEndHeight];\n  const apex = [apexY, apexZ];\n  // soften the point with a small arc\n  const a1 = toward(apex, frontBottom, apexRadius);\n  const a2 = toward(apex, backBottom, apexRadius);\n  const aMid = toward(apex, [(a1[0] + a2[0]) / 2, (a1[1] + a2[1]) / 2], apexRadius * 0.3);\n\n  const outline = replicad\n    .draw([0, deckZ])\n    .lineTo(frontBottom)\n    .lineTo(a1)\n    .threePointsArcTo(a2, aMid)\n    .lineTo(backBottom)\n    .lineTo([depth, deckZ])\n    .close();\n\n  let shape = outline;\n  for (const h of [[pivotY, pivotZ], [knobY, knobZ]]) {\n    shape = shape.cut(replicad.drawCircle(holeDiameter / 2).translate(h[0], h[1]));\n  }\n  return new Assembly({ geometry: shape });\n}\n",
                  "compiledCode": "\"use strict\";\n/**\n * Side profile of one layer of the base, traced from the close-up side photo,\n * in sofa coordinates: x = depth from the front, y = height above the floor, mm.\n * An inverted triangle: the top edge is the seat deck surface, the short ends cover\n * the rails, and the bottom edges meet in a point just above the floor, under the\n * back/arm bracket's pivot.\n * Holes: the pivot the back/arm bracket rotates on, and the knob.\n */\nfunction run(depth = 800, deckZ = 209.6, frontEndHeight = 57, frontEndSlant = 7.5, backEndHeight = 68, backEndSlant = 5, apexY = 305, apexZ = 30, apexRadius = 12, pivotY = 292, pivotZ = 81, knobY = 460, knobZ = 171, holeDiameter = 12) {\n    const toward = (p, q, dist) => {\n        const dx = q[0] - p[0];\n        const dy = q[1] - p[1];\n        const len = Math.hypot(dx, dy);\n        return [p[0] + (dx / len) * dist, p[1] + (dy / len) * dist];\n    };\n    const frontBottom = [frontEndSlant, deckZ - frontEndHeight];\n    const backBottom = [depth - backEndSlant, deckZ - backEndHeight];\n    const apex = [apexY, apexZ];\n    // soften the point with a small arc\n    const a1 = toward(apex, frontBottom, apexRadius);\n    const a2 = toward(apex, backBottom, apexRadius);\n    const aMid = toward(apex, [(a1[0] + a2[0]) / 2, (a1[1] + a2[1]) / 2], apexRadius * 0.3);\n    const outline = replicad\n        .draw([0, deckZ])\n        .lineTo(frontBottom)\n        .lineTo(a1)\n        .threePointsArcTo(a2, aMid)\n        .lineTo(backBottom)\n        .lineTo([depth, deckZ])\n        .close();\n    let shape = outline;\n    for (const h of [[pivotY, pivotZ], [knobY, knobZ]]) {\n        shape = shape.cut(replicad.drawCircle(holeDiameter / 2).translate(h[0], h[1]));\n    }\n    return new Assembly({ geometry: shape });\n}\n"
                },
