            }
          ]
        },
        {
          "atomType": "Molecule",
          "x": 0.2,
          "y": 0.3,
          "uniqueID": "id-1125525",
          "name": "Arm Bracket",
          "ioValues": [
            {
              "name": "thickness",
              "ioValue": 19.05,
              "currentEquation": "thickness"
            }
          ],
          "topLevel": false,
          "allAtoms": [
            {
              "atomType": "Output",
              "x": 1,
              "y": 0.5,
              "uniqueID": "id-1125527",
              "ioValues": [
                {
                  "name": "number or geometry",
                  "ioValue": "__GEOMETRY_INPUT__"
                }
              ]
            },
            {
              "atomType": "Code",
              "x": 0.2,
              "y": 0.5,
              "uniqueID": "id-1125529",
              "ioValues": [
                {
                  "name": "strutWidth",
                  "ioValue": 85
                },
                {
                  "name": "armThickness",
                  "ioValue": 50,
                  "currentEquation": "50"
                },
                {
                  "name": "strutAngle",
                  "ioValue": 55.5
                },
                {
                  "name": "topS",
                  "ioValue": 650
                },
                {
                  "name": "bottomS",
                  "ioValue": -110
                },
                {
                  "name": "armS",
                  "ioValue": 423
                },
                {
                  "name": "armAngle",
                  "ioValue": 111.5
                },
                {
                  "name": "armLength",
                  "ioValue": 218
                },
                {
                  "name": "filletLength",
                  "ioValue": 70
                },
                {
                  "name": "lockPinOffset",
                  "ioValue": 110
                },
                {
                  "name": "holeDiameter",
                  "ioValue": 12
                }
              ],
              "interpreterVersion": 1,
              "code": "/**\n * Side profile of the arm / backrest bracket (traced from the side photo), drawn in the\n * pivot frame: origin = pivot pin, x = depth (toward the back), y = height, sofa position, mm.\n * A reclined strut carries the backrest. Its rounded lower end is pinned to the base;\n * an armrest branch leaves the front edge at armAngle to the strut.\n * Folding the back forward by (180 - strutAngle) lays the strut flat at deck level and\n * swings the armrest straight down so it becomes a leg for the bed extension;\n * armLength is chosen so the arm then reaches the floor.\n * Holes: pivot (origin) and the lock pin at lockPinOffset down the strut.\n */\nfunction run(\n  strutAngle: number = 55.5,\n  strutWidth: number = 85,\n  topS: number = 650,\n  bottomS: number = -110,\n  armS: number = 423,\n  armAngle: number = 111.5,\n  armLength: number = 190,\n  armThickness: number = 50,\n  filletLength: number = 70,\n  lockPinOffset: number = 110,\n  holeDiameter: number = 12,\n): Assembly {\n  const a = (strutAngle * Math.PI) / 180;\n  const h = strutWidth / 2;\n  // local (s, n): s up the strut, n across it toward the back\n  const P = (s: number, n: number) => [\n    s * Math.cos(a) + n * Math.sin(a),\n    s * Math.sin(a) - n * Math.cos(a),\n  ];\n  const Pp = (p: number[]) => P(p[0], p[1]);\n  // arm direction in (s, n); +90 deg from the strut axis is -n\n  const b = (armAngle * Math.PI) / 180;\n  const u = [Math.cos(b), -Math.sin(b)];\n  const v = [-u[1], u[0]]; // across the arm, toward +s\n  const r = armThickness / 2;\n  const root = [armS, -h];\n  const along = (p: number[], t: number) => [p[0] + u[0] * t, p[1] + u[1] * t];\n  // where each arm edge meets the strut front edge (n = -h)\n  const edgeRoot = (k: number) => {\n    const p = [root[0] + v[0] * r * k, root[1] + v[1] * r * k];\n    return along(p, (-h - p[1]) / u[1]);\n  };\n  const upRoot = edgeRoot(1);\n  const loRoot = edgeRoot(-1);\n  const tipC = along(root, armLength - r);\n  const upTip = [tipC[0] + v[0] * r, tipC[1] + v[1] * r];\n  const loTip = [tipC[0] - v[0] * r, tipC[1] - v[1] * r];\n  const tipEnd = along(tipC, r);\n  const f = filletLength;\n\n  const outline = replicad\n    .draw(P(bottomS, -h))\n    // front edge up to the crotch under the arm\n    .lineTo(P(loRoot[0] - f, -h))\n    .cubicBezierCurveTo(Pp(along(loRoot, f)), P(loRoot[0] - f * 0.4, -h), Pp(along(loRoot, f * 0.4)))\n    // underside of the arm, rounded tip, top of the arm\n    .lineTo(Pp(loTip))\n    .threePointsArcTo(Pp(upTip), Pp(tipEnd))\n    .lineTo(Pp(along(upRoot, f * 0.6)))\n    .cubicBezierCurveTo(P(upRoot[0] + f * 0.8, -h), Pp(along(upRoot, f * 0.2)), P(upRoot[0] + f * 0.3, -h))\n    // rest of the front edge, rounded top, back edge, rounded lower end\n    .lineTo(P(topS, -h))\n    .threePointsArcTo(P(topS, h), P(topS + h, 0))\n    .lineTo(P(bottomS, h))\n    .threePointsArcTo(P(bottomS, -h), P(bottomS - h, 0))\n    .close();\n\n  let shape = outline;\n  for (const hole of [P(0, 0), P(-lockPinOffset, 0)]) {\n    shape = shape.cut(replicad.drawCircle(holeDiameter / 2).translate(hole[0], hole[1]));\n  }\n  return new Assembly({ geometry: shape });\n}\n",
              "compiledCode": "\"use strict\";\n/**\n * Side profile of the arm / backrest bracket (traced from the side photo), drawn in the\n * pivot frame: origin = pivot pin, x = depth (toward the back), y = height, sofa position, mm.\n * A reclined strut carries the backrest. Its rounded lower end is pinned to the base;\n * an armrest branch leaves the front edge at armAngle to the strut.\n * Folding the back forward by (180 - strutAngle) lays the strut flat at deck level and\n * swings the armrest straight down so it becomes a leg for the bed extension;\n * armLength is chosen so the arm then reaches the floor.\n * Holes: pivot (origin) and the lock pin at lockPinOffset down the strut.\n */\nfunction run(strutAngle = 55.5, strutWidth = 85, topS = 650, bottomS = -110, armS = 423, armAngle = 111.5, armLength = 190, armThickness = 50, filletLength = 70, lockPinOffset = 110, holeDiameter = 12) {\n    const a = (strutAngle * Math.PI) / 180;\n    const h = strutWidth / 2;\n    // local (s, n): s up the strut, n across it toward the back\n    const P = (s, n) => [\n        s * Math.cos(a) + n * Math.sin(a),\n        s * Math.sin(a) - n * Math.cos(a),\n    ];\n    const Pp = (p) => P(p[0], p[1]);\n    // arm direction in (s, n); +90 deg from the strut axis is -n\n    const b = (armAngle * Math.PI) / 180;\n    const u = [Math.cos(b), -Math.sin(b)];\n    const v = [-u[1], u[0]]; // across the arm, toward +s\n    const r = armThickness / 2;\n    const root = [armS, -h];\n    const along = (p, t) => [p[0] + u[0] * t, p[1] + u[1] * t];\n    // where each arm edge meets the strut front edge (n = -h)\n    const edgeRoot = (k) => {\n        const p = [root[0] + v[0] * r * k, root[1] + v[1] * r * k];\n        return along(p, (-h - p[1]) / u[1]);\n    };\n    const upRoot = edgeRoot(1);\n    const loRoot = edgeRoot(-1);\n    const tipC = along(root, armLength - r);\n    const upTip = [tipC[0] + v[0] * r, tipC[1] + v[1] * r];\n    const loTip = [tipC[0] - v[0] * r, tipC[1] - v[1] * r];\n    const tipEnd = along(tipC, r);\n    const f = filletLength;\n    const outline = replicad\n        .draw(P(bottomS, -h))\n        // front edge up to the crotch under the arm\n        .lineTo(P(loRoot[0] - f, -h))\n        .cubicBezierCurveTo(Pp(along(loRoot, f)), P(loRoot[0] - f * 0.4, -h), Pp(along(loRoot, f * 0.4)))\n        // underside of the arm, rounded tip, top of the arm\n        .lineTo(Pp(loTip))\n        .threePointsArcTo(Pp(upTip), Pp(tipEnd))\n        .lineTo(Pp(along(upRoot, f * 0.6)))\n        .cubicBezierCurveTo(P(upRoot[0] + f * 0.8, -h), Pp(along(upRoot, f * 0.2)), P(upRoot[0] + f * 0.3, -h))\n        // rest of the front edge, rounded top, back edge, rounded lower end\n        .lineTo(P(topS, -h))\n        .threePointsArcTo(P(topS, h), P(topS + h, 0))\n        .lineTo(P(bottomS, h))\n        .threePointsArcTo(P(bottomS, -h), P(bottomS - h, 0))\n        .close();\n    let shape = outline;\n    for (const hole of [P(0, 0), P(-lockPinOffset, 0)]) {\n        shape = shape.cut(replicad.drawCircle(holeDiameter / 2).translate(hole[0], hole[1]));\n    }\n    return new Assembly({ geometry: shape });\n}\n"
            },
