                      "name": "splay",
                      "ioValue": 12
                    }
                  ],
                  "interpreterVersion": 1,
                  "code": "/**\n * Side-view outline of one leg lamination, drawn in sofa coordinates\n * (x = depth from the front of the seat frame, y = height above the floor), all in mm.\n * topY: depth position of the top center. height: floor to top of leg.\n * Top and bottom edges are horizontal; the leg leans forward by `splay` degrees.\n */\nfunction run(\n  topY: number = 100,\n  height: number = 270,\n  topWidth: number = 60,\n  bottomWidth: number = 32,\n  splay: number = 12,\n): Assembly {\n  const shift = height * Math.tan((splay * Math.PI) / 180);\n  const bottomY = topY - shift;\n  const outline = replicad\n    .draw([bottomY - bottomWidth / 2, 0])\n    .lineTo([bottomY + bottomWidth / 2, 0])\n    .lineTo([topY + topWidth / 2, height])\n    .lineTo([topY - topWidth / 2, height])\n    .close();\n  return new Assembly({ geometry: outline });\n}\n",
                  "compiledCode": "\"use strict\";\n/**\n * Side-view outline of one leg lamination, drawn in sofa coordinates\n * (x = depth from the front of the seat frame, y = height above the floor), all in mm.\n * topY: depth position of the top center. height: floor to top of leg.\n * Top and bottom edges are horizontal; the leg leans forward by `splay` degrees.\n */\nfunction run(topY = 100, height = 270, topWidth = 60, bottomWidth = 32, splay = 12) {\n    const shift = height * Math.tan((splay * Math.PI) / 180);\n    const bottomY = topY - shift;\n    const outline = replicad\n        .draw([bottomY - bottomWidth / 2, 0])\n        .lineTo([bottomY + bottomWidth / 2, 0])\n        .lineTo([topY + topWidth / 2, height])\n        .lineTo([topY - topWidth / 2, height])\n        .close();\n    return new Assembly({ geometry: outline });\n}\n"
                },
