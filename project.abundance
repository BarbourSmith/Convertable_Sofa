    {
      "atomType": "Molecule",
      "x": 0.3,
      "y": 0.7,
      "uniqueID": "id-1125521",
      "name": "Back and Arms",
      "ioValues": [
        {
          "name": "thickness",
          "ioValue": 19.05
        },
        {
          "name": "position",
          "ioValue": 0
        }
      ],
      "topLevel": false,
      "allAtoms": [
        {
          "atomType": "Output",
          "x": 1,
          "y": 0.5,
          "uniqueID": "id-1125523",
          "ioValues": [
            {
              "name": "number or geometry",
