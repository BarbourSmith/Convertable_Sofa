            },
            {
              "atomType": "Code",
              "x": 0.2,
              "y": 0.5,
              "uniqueID": "id-1125529",
              "ioValues": [
                {
                  "name": "pivotY",
                  "ioValue": 292
                },
                {
                  "name": "pivotZ",
                  "ioValue": 81
                },
                {
                  "name": "endRadius",
                  "ioValue": 23
                },
                {
                  "name": "frontAngle",
                  "ioValue": 57.5
                },
                {
                  "name": "backAngle",
                  "ioValue": 52
                },
                {
                  "name": "topFrontZ",
                  "ioValue": 715
                },
                {
                  "name": "topBackZ",
                  "ioValue": 680
                },
                {
                  "name": "capY",
                  "ioValue": 730
                },
                {
                  "name": "capZ",
                  "ioValue": 738
                },
                {
                  "name": "crotchZ",
                  "ioValue": 421
                },
                {
                  "name": "armRootZ",
                  "ioValue": 600
                },
                {
                  "name": "armTopY",
                  "ioValue": 500
                },
                {
                  "name": "armTipY",
                  "ioValue": 265
                },
                {
                  "name": "armTipTopZ",
                  "ioValue": 571
                },
                {
                  "name": "armTipBottomZ",
                  "ioValue": 521
                },
                {
                  "name": "upperHoleY",
                  "ioValue": 501
                },
                {
                  "name": "upperHoleZ",
                  "ioValue": 381
                },
                {
                  "name": "holeDiameter",
                  "ioValue": 12
                }
              ],
              "interpreterVersion": 1,
              "code": "/**\n * Side profile of the arm / backrest bracket, traced from the side photos.\n * Points are in sofa coordinates (x = depth from the front, y = height above\n * the floor, mm, upright position); the result is shifted so the pivot (the lower\n * hole) sits at the origin, ready to be rotated for the bed position.\n * The strut tapers from a narrow rounded lower end (around the pivot) to a wide\n * rounded top; the armrest leaves the front edge and rises slightly toward its tip.\n */\nfunction run(\n  pivotY: number = 292,\n  pivotZ: number = 81,\n  endRadius: number = 23,\n  frontAngle: number = 57.5,\n  backAngle: number = 52,\n  topFrontZ: number = 715,\n  topBackZ: number = 680,\n  capY: number = 730,\n  capZ: number = 738,\n  crotchZ: number = 421,\n  armRootZ: number = 560,\n  armTopY: number = 500,\n  armTipY: number = 265,\n  armTipTopZ: number = 571,\n  armTipBottomZ: number = 521,\n  upperHoleY: number = 501,\n  upperHoleZ: number = 381,\n  holeDiameter: number = 12,\n): Assembly {\n  const rad = (deg: number) => (deg * Math.PI) / 180;\n  const df = [Math.cos(rad(frontAngle)), Math.sin(rad(frontAngle))];\n  const db = [Math.cos(rad(backAngle)), Math.sin(rad(backAngle))];\n  // tangent points of the front and back edges on the rounded lower end\n  const f0 = [pivotY - endRadius * df[1], pivotZ + endRadius * df[0]];\n  const b0 = [pivotY + endRadius * db[1], pivotZ - endRadius * db[0]];\n  const frontAt = (z: number) => [f0[0] + ((z - f0[1]) / df[1]) * df[0], z];\n  const backAt = (z: number) => [b0[0] + ((z - b0[1]) / db[1]) * db[0], z];\n  const mid = [-(df[0] + db[0]), -(df[1] + db[1])];\n  const ml = Math.hypot(mid[0], mid[1]);\n  const endMid = [pivotY + (endRadius * mid[0]) / ml, pivotZ + (endRadius * mid[1]) / ml];\n\n  const crotch = frontAt(crotchZ);\n  const armRoot = frontAt(armRootZ);\n  const armTop = [armTopY, armTipTopZ + ((armTopY - armTipY) / (armRoot[0] - armTipY)) * (armRoot[1] - armTipTopZ) * 0.6];\n  const tipR = (armTipTopZ - armTipBottomZ) / 2;\n  const tipMid = [armTipY - tipR, (armTipTopZ + armTipBottomZ) / 2];\n\n  const outline = replicad\n    .draw(b0)\n    .threePointsArcTo(f0, endMid)\n    .lineTo(crotch)\n    // underside of the armrest: leaves the front edge and sweeps forward to the tip\n    .cubicBezierCurveTo(\n      [armTipY, armTipBottomZ],\n      [crotch[0] + 40 * df[0], crotch[1] + 40 * df[1]],\n      [armTipY + 110, armTipBottomZ - 6],\n    )\n    .threePointsArcTo([armTipY, armTipTopZ], tipMid)\n    .lineTo(armTop)\n    // top of the armrest blends back into the front edge\n    .cubicBezierCurveTo(\n      armRoot,\n      [armTop[0] + 30, armTop[1] - 3],\n      [armRoot[0] - 22 * df[0], armRoot[1] - 22 * df[1]],\n    )\n    .lineTo(frontAt(topFrontZ))\n    .threePointsArcTo(backAt(topBackZ), [capY, capZ])\n    .close();\n\n  let shape = outline;\n  for (const h of [[pivotY, pivotZ], [upperHoleY, upperHoleZ]]) {\n    shape = shape.cut(replicad.drawCircle(holeDiameter / 2).translate(h[0], h[1]));\n  }\n  return new Assembly({ geometry: shape.translate(-pivotY, -pivotZ) });\n}\n",
              "compiledCode": "\"use strict\";\n/**\n * Side profile of the arm / backrest bracket, traced from the side photos.\n * Points are in sofa coordinates (x = depth from the front, y = height above\n * the floor, mm, upright position); the result is shifted so the pivot (the lower\n * hole) sits at the origin, ready to be rotated for the bed position.\n * The strut tapers from a narrow rounded lower end (around the pivot) to a wide\n * rounded top; the armrest leaves the front edge and rises slightly toward its tip.\n */\nfunction run(pivotY = 292, pivotZ = 81, endRadius = 23, frontAngle = 57.5, backAngle = 52, topFrontZ = 715, topBackZ = 680, capY = 730, capZ = 738, crotchZ = 421, armRootZ = 560, armTopY = 500, armTipY = 265, armTipTopZ = 571, armTipBottomZ = 521, upperHoleY = 501, upperHoleZ = 381, holeDiameter = 12) {\n    const rad = (deg) => (deg * Math.PI) / 180;\n    const df = [Math.cos(rad(frontAngle)), Math.sin(rad(frontAngle))];\n    const db = [Math.cos(rad(backAngle)), Math.sin(rad(backAngle))];\n    // tangent points of the front and back edges on the rounded lower end\n    const f0 = [pivotY - endRadius * df[1], pivotZ + endRadius * df[0]];\n    const b0 = [pivotY + endRadius * db[1], pivotZ - endRadius * db[0]];\n    const frontAt = (z) => [f0[0] + ((z - f0[1]) / df[1]) * df[0], z];\n    const backAt = (z) => [b0[0] + ((z - b0[1]) / db[1]) * db[0], z];\n    const mid = [-(df[0] + db[0]), -(df[1] + db[1])];\n    const ml = Math.hypot(mid[0], mid[1]);\n    const endMid = [pivotY + (endRadius * mid[0]) / ml, pivotZ + (endRadius * mid[1]) / ml];\n    const crotch = frontAt(crotchZ);\n    const armRoot = frontAt(armRootZ);\n    const armTop = [armTopY, armTipTopZ + ((armTopY - armTipY) / (armRoot[0] - armTipY)) * (armRoot[1] - armTipTopZ) * 0.6];\n    const tipR = (armTipTopZ - armTipBottomZ) / 2;\n    const tipMid = [armTipY - tipR, (armTipTopZ + armTipBottomZ) / 2];\n    const outline = replicad\n        .draw(b0)\n        .threePointsArcTo(f0, endMid)\n        .lineTo(crotch)\n        // underside of the armrest: leaves the front edge and sweeps forward to the tip\n        .cubicBezierCurveTo([armTipY, armTipBottomZ], [crotch[0] + 40 * df[0], crotch[1] + 40 * df[1]], [armTipY + 110, armTipBottomZ - 6])\n        .threePointsArcTo([armTipY, armTipTopZ], tipMid)\n        .lineTo(armTop)\n        // top of the armrest blends back into the front edge\n        .cubicBezierCurveTo(armRoot, [armTop[0] + 30, armTop[1] - 3], [armRoot[0] - 22 * df[0], armRoot[1] - 22 * df[1]])\n        .lineTo(frontAt(topFrontZ))\n        .threePointsArcTo(backAt(topBackZ), [capY, capZ])\n        .close();\n    let shape = outline;\n    for (const h of [[pivotY, pivotZ], [upperHoleY, upperHoleZ]]) {\n        shape = shape.cut(replicad.drawCircle(holeDiameter / 2).translate(h[0], h[1]));\n    }\n    return new Assembly({ geometry: shape.translate(-pivotY, -pivotZ) });\n}\n"
            },
